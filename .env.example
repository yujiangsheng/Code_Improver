# Copy to .env and fill in.
# Works with any OpenAI-compatible endpoint (OpenAI, DeepSeek, Moonshot, vLLM, Ollama, ...).

# Copy to .env and adjust as needed.
# DEFAULTS target a local Ollama instance — no API key required.
# Make sure Ollama is running:  `ollama serve`
# And pull the models you intend to use, e.g.:
#   ollama pull qwen3-coder
#   ollama pull qwen3
#
# To use a hosted provider instead, set OPENAI_BASE_URL + OPENAI_API_KEY:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_API_KEY=sk-xxx

OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama

# Two-tier model routing. ADA_MODEL is the fallback if the specific tier is unset.
# Available Ollama models on this machine:
#   qwen3.5:9b     — fast worker (default)
#   qwen3.5:27b    — capable planner (default)
#   qwen3-coder:30b — strong coding alternative for either role
#   deepseek-r1:8b  — reasoning-focused alternative
ADA_WORKER_MODEL=qwen3.5:9b
ADA_PLANNER_MODEL=qwen3.5:27b
# Alternatives (uncomment to switch):
# ADA_WORKER_MODEL=qwen3-coder:30b
# ADA_PLANNER_MODEL=qwen3-coder:30b
# ADA_MODEL=qwen3-coder

# Optional: LLM request timeout + retry policy for slow local inference.
# Increase timeout if you see: "LLM error: Request timed out."
ADA_LLM_TIMEOUT=600
ADA_LLM_MAX_RETRIES=2

# Optional: cap tool-loop iterations per session
ADA_MAX_STEPS=80
# Optional: command execution timeout (seconds)
ADA_CMD_TIMEOUT=120
